export EDITOR=nvim

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# alias
alias ls="eza --icons"
alias la="eza -l --icons --git -a"
alias dfe="chezmoi edit"
alias dfc="chezmoi cd"
alias dfd="chezmoi diff"
alias dfa="chezmoi apply -v"
alias dfu="chezmoi update -v"
{{- if eq .chezmoi.hostname "pc" }}
alias kb="sudo sh -c 'echo 2 > /sys/module/hid_apple/parameters/fnmode'"
{{- end }}

# starship
eval "$(starship init zsh)"

# functions
v () { 
  nvim $*
}

p () {
  pnpm $*
}

px () {
  pnpm dlx $*
}

# asdf
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# odin
export PATH="$HOME/Odin:$PATH"

# emacs vterm
vterm_printf() {
    if [ -n "$TMUX" ] \
        && { [ "${TERM%%-*}" = "tmux" ] \
            || [ "${TERM%%-*}" = "screen" ]; }; then
        # Tell tmux to pass the escape sequences through
        printf "\ePtmux;\e\e]%s\007\e\\" "$1"
    elif [ "${TERM%%-*}" = "screen" ]; then
        # GNU screen (screen, screen-256color, screen-256color-bce)
        printf "\eP\e]%s\007\e\\" "$1"
    else
        printf "\e]%s\e\\" "$1"
    fi
}

vterm_prompt_end() {
    vterm_printf "51;A$(whoami)@$(hostname):$(pwd)"
}
setopt PROMPT_SUBST
PROMPT=$PROMPT'%{$(vterm_prompt_end)%}'
